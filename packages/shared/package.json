{
  "name": "@formula/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, zod schemas and constants for web and api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@formula/config": "*",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  }
}
