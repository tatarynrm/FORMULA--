# --- Server ---
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000

# Public address of this api (no trailing slash): Google sends the sign-in callback to
# <API_PUBLIC_URL>/api/auth/google/callback. WEB_URL is where the browser goes afterwards.
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Google sign-in (OAuth client of type "Web application" in Google Cloud Console) ---
# Authorised redirect URI there must be exactly: http://localhost:4000/api/auth/google/callback
# Leave both empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram bot "Formula" (notifications in Telegram). Empty token = the bot is off, nothing else is needed.
# Create the bot with @BotFather, put its token here and its name (without @) below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (default): the api asks Telegram for messages, no public address needed, run ONE api instance.
# webhook: Telegram calls POST /api/messengers/telegram/webhook (needs API_PUBLIC_URL over https
# and TELEGRAM_WEBHOOK_SECRET, 16+ random characters). Use it in production.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- PostgreSQL (plain SQL via node-postgres, no ORM) ---
DATABASE_URL=postgresql://formula:formula@localhost:5442/formula

# --- Redis (reserved for cache / queues) ---
REDIS_URL=redis://localhost:6379

# Cookie domain for the auth cookies (leave empty on localhost; e.g. formula.example.com in production)
COOKIE_DOMAIN=

# --- JWT (use long random strings, e.g. `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d

# --- File storage (videos, documents, images). Mount a persistent volume here in production ---
STORAGE_DIR=./storage

# --- Rate limit (requests per window per IP) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
