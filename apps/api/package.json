{
  "name": "@formula/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node scripts/e2e-learning.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:new": "node scripts/new-migration.mjs",
    "seed:biology": "node --env-file-if-exists=.env scripts/seed-biology.mjs",
    "files:cleanup": "node --env-file-if-exists=.env scripts/clean-files.mjs",
    "user:set-role": "node --env-file-if-exists=.env scripts/set-role.mjs"
  },
  "dependencies": {
    "@formula/shared": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@formula/config": "*",
    "@nestjs/testing": "^12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
