# Used by docker-compose.prod.yml on the VPS. Copy to .env.production and fill in. Never commit the real file.

# Public domain that points at the VPS (A record), without protocol
DOMAIN=formula.example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=admin@example.com

# Optional: token from Google Search Console ("HTML tag" verification method)
GOOGLE_SITE_VERIFICATION=

# Strong random values, e.g. `openssl rand -base64 32` (secrets: `openssl rand -base64 48`)
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google sign-in: OAuth client (type "Web application") with the redirect URI
# https://<DOMAIN>/api/auth/google/callback. Leave empty to keep it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram bot "Formula". Empty token = the bot is off. Production uses the webhook mode:
# API_PUBLIC_URL must be the https address of the site, the secret is 16+ random characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
